[Unit]
Description=Gantry shared development workspace API
After=network.target

[Service]
Type=simple
User=gantry
Group=gantry
WorkingDirectory=/var/lib/gantry
ExecStart=/opt/gantry/current/bin/gantry serve-cloud --root /var/lib/gantry/workspaces --host 127.0.0.1 --port 8770
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gantry
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
TasksMax=128
LimitNOFILE=4096
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
